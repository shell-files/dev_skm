{
  "version": "1.0",
  "ruleVersion": "dma-rule-v1.3-mvp",
  "resolverVersion": "media-event-resolver-v1.0",
  "scoreDecisionByAiAllowedYn": false,
  "eventTypeNormalization": {
    "unknownPolicy": "PASSTHROUGH",
    "aliases": {}
  },
  "impactScaleRules": {
    "sourceField": "affectedCount",
    "bands": [
      {"min": 1, "max": 10, "minInclusive": true, "maxExclusive": true, "score": 1},
      {"min": 10, "max": 100, "minInclusive": true, "maxExclusive": true, "score": 2},
      {"min": 100, "max": 1000, "minInclusive": true, "maxExclusive": true, "score": 3},
      {"min": 1000, "max": 10000, "minInclusive": true, "maxExclusive": true, "score": 4},
      {"min": 10000, "max": null, "minInclusive": true, "maxExclusive": false, "score": 5}
    ],
    "missingPolicy": "UNOBSERVED"
  },
  "impactScopeRules": {
    "enabledYn": false,
    "sourceField": null,
    "bands": [],
    "missingPolicy": "UNOBSERVED",
    "pendingReason": "UPSTREAM_SCOPE_FACT_CONTRACT_REQUIRED"
  },
  "impactLikelihoodRules": {
    "sourceField": "probabilityValue",
    "normalization": "ZERO_TO_ONE_OR_PERCENT",
    "bands": [
      {"min": 0.0, "max": 0.05, "minInclusive": true, "maxExclusive": true, "score": 1},
      {"min": 0.05, "max": 0.20, "minInclusive": true, "maxExclusive": true, "score": 2},
      {"min": 0.20, "max": 0.50, "minInclusive": true, "maxExclusive": true, "score": 3},
      {"min": 0.50, "max": 0.80, "minInclusive": true, "maxExclusive": true, "score": 4},
      {"min": 0.80, "max": 1.0, "minInclusive": true, "maxExclusive": false, "score": 5}
    ],
    "missingPolicy": "UNOBSERVED"
  },
  "impactIrremediabilityRules": {
    "sourceField": null,
    "missingPolicy": "UNOBSERVED"
  },
  "financialMagnitudeRules": {
    "primarySource": "ratioValue",
    "fallbackSource": null,
    "financialAmountDirectScoringAllowedYn": false,
    "canonicalBandsRef": "canonical_scoring_policy.financialMagnitudeRatioBands",
    "bands": [
      {"min": 0.0, "max": 0.001, "minInclusive": false, "maxExclusive": true, "score": 1},
      {"min": 0.001, "max": 0.005, "minInclusive": true, "maxExclusive": true, "score": 2},
      {"min": 0.005, "max": 0.01, "minInclusive": true, "maxExclusive": true, "score": 3},
      {"min": 0.01, "max": 0.03, "minInclusive": true, "maxExclusive": true, "score": 4},
      {"min": 0.03, "max": null, "minInclusive": true, "maxExclusive": false, "score": 5}
    ],
    "missingPolicy": "UNOBSERVED"
  },
  "financialLikelihoodRules": {
    "sourceField": "probabilityValue",
    "normalization": "ZERO_TO_ONE_OR_PERCENT",
    "bands": [
      {"min": 0.0, "max": 0.05, "minInclusive": true, "maxExclusive": true, "score": 1},
      {"min": 0.05, "max": 0.20, "minInclusive": true, "maxExclusive": true, "score": 2},
      {"min": 0.20, "max": 0.50, "minInclusive": true, "maxExclusive": true, "score": 3},
      {"min": 0.50, "max": 0.80, "minInclusive": true, "maxExclusive": true, "score": 4},
      {"min": 0.80, "max": 1.0, "minInclusive": true, "maxExclusive": false, "score": 5}
    ],
    "missingPolicy": "UNOBSERVED"
  },
  "timeHorizonRules": {
    "sourcePriority": ["deadlineDate", "effectiveDate", "eventDate"],
    "shortMaxDays": 365,
    "midMaxDays": 1095,
    "pastDatePolicy": "short",
    "missingPolicy": "UNOBSERVED"
  },
  "eventDedupRules": {
    "mandatoryKeys": ["subIssueCode", "normalizedEventType", "eventDateBucket"],
    "advisoryOnlyFields": ["eventGroupCandidateId"],
    "mergePolicy": "COMPOSITE_PLUS_MATCHING_ADVISORY_HINT",
    "conflictPolicy": "CONFLICTED",
    "missingMandatoryKeyPolicy": "UNRESOLVED",
    "dateBucketSourcePriority": ["eventDate", "effectiveDate", "deadlineDate"],
    "dateBucketPrecision": "DAY"
  },
  "ratioValueContract": {
    "normalization": "DECIMAL_RATIO_ONLY",
    "min": 0.0,
    "max": 1.0,
    "outOfRangePolicy": "REJECTED"
  },
  "missingPolicy": {
    "requiredFactorMissing": "UNOBSERVED",
    "missingAsZeroForbiddenYn": true
  }
